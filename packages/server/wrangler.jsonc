/**
 * Actian trial-download Worker.
 *
 * Files live in a private R2 bucket. D1-backed opaque download grants are
 * short-lived. Country, IP, and business-email gating are enforced on both
 * link issuance and download. LEAD_HASH_SECRET must be set with:
 *   wrangler secret put LEAD_HASH_SECRET --env production
 *
 * POST /webhook/marketo persists authenticated callback metadata for
 * attribution (no gating applied). MARKETO_WEBHOOK_SECRET must be set with:
 *   wrangler secret put MARKETO_WEBHOOK_SECRET --env production
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "actian-trial-downloads",
	"account_id": "59aa7befa9d1b3d2d72d78676dd7001d",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"CORS_ORIGINS": "*",
		"LINK_TTL_SECONDS": "600",
		"ALLOWED_FILES": "{}",
		"BLOCKED_IPS": "",
		"EXTRA_BLOCKED_COUNTRIES": "",
		"EXTRA_BLOCKED_EMAIL_LABELS": ""
	},
	"r2_buckets": [
		{
			"binding": "DOWNLOADS",
			"bucket_name": "actian-trial-downloads"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "actian-trial-downloads",
			"database_id": "f288d15c-51df-4dde-b613-f4a6d1ed877c"
		}
	],
	"env": {
		"production": {
			"name": "actian-trial-downloads",
			"vars": {
				"CORS_ORIGINS": "*",
				"LINK_TTL_SECONDS": "600",
				"ALLOWED_FILES": "{}",
				"BLOCKED_IPS": "",
				"EXTRA_BLOCKED_COUNTRIES": "",
				"EXTRA_BLOCKED_EMAIL_LABELS": "",
				"R2_ACCOUNT_ID": "59aa7befa9d1b3d2d72d78676dd7001d",
				"R2_BUCKET_NAME": "actian-trial-downloads"
			},
			"r2_buckets": [
				{
					"binding": "DOWNLOADS",
					"bucket_name": "actian-trial-downloads"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "actian-trial-downloads",
					"database_id": "f288d15c-51df-4dde-b613-f4a6d1ed877c"
				}
			]
		},
		"development": {
			"name": "actian-trial-downloads-dev",
			"vars": {
				"CORS_ORIGINS": "*",
				"LINK_TTL_SECONDS": "600",
				"ALLOWED_FILES": "{}",
				"BLOCKED_IPS": "",
				"EXTRA_BLOCKED_COUNTRIES": "",
				"EXTRA_BLOCKED_EMAIL_LABELS": "",
				"R2_ACCOUNT_ID": "59aa7befa9d1b3d2d72d78676dd7001d",
				"R2_BUCKET_NAME": "actian-trial-downloads"
			},
			"r2_buckets": [
				{
					"binding": "DOWNLOADS",
					"bucket_name": "actian-trial-downloads-dev"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "actian-trial-downloads-dev",
					"database_id": "460c682c-7f9f-48a2-b5b4-b31fcff96a5d"
				}
			]
		}
	}
}