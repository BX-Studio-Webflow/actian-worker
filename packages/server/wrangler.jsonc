/**
 * Actian trial-download Worker.
 *
 * Files live in a private R2 bucket. Download links are HMAC-signed and
 * short-lived. Country, IP, and business-email gating are enforced on both
 * link issuance and download. TOKEN_SECRET must be set with:
 *   wrangler secret put TOKEN_SECRET --env production
 *
 * POST /webhook/marketo logs every Marketo form submission for attribution
 * (no gating applied). MARKETO_WEBHOOK_SECRET must be set with:
 *   wrangler secret put MARKETO_WEBHOOK_SECRET --env production
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "actian-trial-downloads",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-01",
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1
	},
	"vars": {
		"CORS_ORIGINS": "*",
		"LINK_TTL_SECONDS": "600",
		"ALLOWED_FILES": "{}",
		"BLOCKED_IPS": "",
		"EXTRA_BLOCKED_COUNTRIES": "",
		"EXTRA_BLOCKED_EMAIL_LABELS": ""
	},
	"r2_buckets": [
		{
			"binding": "DOWNLOADS",
			"bucket_name": "actian-trial-downloads"
		}
	],
	"env": {
		"production": {
			"name": "actian-trial-downloads",
			"vars": {
				"CORS_ORIGINS": "*",
				"LINK_TTL_SECONDS": "600",
				"ALLOWED_FILES": "{}",
				"BLOCKED_IPS": "",
				"EXTRA_BLOCKED_COUNTRIES": "",
				"EXTRA_BLOCKED_EMAIL_LABELS": ""
			},
			"r2_buckets": [
				{
					"binding": "DOWNLOADS",
					"bucket_name": "actian-trial-downloads"
				}
			]
		},
		"development": {
			"name": "actian-trial-downloads-dev",
			"vars": {
				"CORS_ORIGINS": "*",
				"LINK_TTL_SECONDS": "600",
				"ALLOWED_FILES": "{}",
				"BLOCKED_IPS": "",
				"EXTRA_BLOCKED_COUNTRIES": "",
				"EXTRA_BLOCKED_EMAIL_LABELS": ""
			},
			"r2_buckets": [
				{
					"binding": "DOWNLOADS",
					"bucket_name": "actian-trial-downloads-dev"
				}
			]
		}
	}
}
