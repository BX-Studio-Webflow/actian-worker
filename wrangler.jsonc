/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webflow-wp-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-17",
	"observability": {
		"enabled": true
	},
	"env": {
		"production": {
			"name": "webflow-wp-proxy-prod",
			"vars": {
				"DOMAIN": "https://www.bxstudio.cloud/",
				"IMAGE_FORMAT": "auto",
				"IMAGE_QUALITY": "85",
				"OG_IMAGE_FORMAT": "jpeg",
				"OG_IMAGE_QUALITY": "80",
				"EDGE_CACHE_TTL": "31536000",
				"BROWSER_CACHE_TTL": "604800",
				"CATCH_ALL_EXTERNAL": "false"
			}
		},
		"development": {
			"name": "webflow-wp-proxy-dev",
			"vars": {
				"DOMAIN": "https://www.bxstudio.cloud/",
				"IMAGE_FORMAT": "auto",
				"IMAGE_QUALITY": "85",
				"OG_IMAGE_FORMAT": "jpeg",
				"OG_IMAGE_QUALITY": "80",
				"EDGE_CACHE_TTL": "31536000",
				"BROWSER_CACHE_TTL": "604800",
				"CATCH_ALL_EXTERNAL": "false"
			}
		}
	},
	
}