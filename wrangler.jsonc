/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "webflow-wp-proxy",
	"main": "src/index.ts",
	"compatibility_date": "2025-11-17",
	"observability": {
		"enabled": true
	},
	"env": {
		"production": {
			"name": "webflow-wp-proxy-prod",
			"triggers": {
				"crons": ["0 * * * *"]
			},
			"vars": {
				"DOMAIN": "www.bxstudio.cloud",
				"IMAGE_FORMAT": "auto",
				"IMAGE_QUALITY": "85",
				"OG_IMAGE_FORMAT": "jpeg",
				"OG_IMAGE_QUALITY": "80",
				"EDGE_CACHE_TTL": "31536000",
				"BROWSER_CACHE_TTL": "15778476",
				"CATCH_ALL_EXTERNAL": "false",
				"SITE_ID": "69259def79719995b09e699d",
				"PURIFIED_CSS_ENABLED": "true",
				"MINIFIED_CSS_LINK": "https://storage.bxstudio.cloud/styles.pure.css",
				"PROGRESSIVE_SECTIONS_ENABLED": "true",
				"OPTIMISE_LANDING_PAGE_ONLY": "true",
				"DISPATCH_EVENT": "DOM_LOADED",
				"CF_ZONE_ID": "b546996735d873188683fc53ccb2df41",
				"CF_API_TOKEN": "iXtEAlzJHoN9941z0VL3BkVtbRaFz9l6NQGy5JgN"
			}
		},
		"development": {
			"name": "webflow-wp-proxy-dev",
			"vars": {
				"DOMAIN": "www.bxstudio.cloud",
				"IMAGE_FORMAT": "auto",
				"IMAGE_QUALITY": "85",
				"OG_IMAGE_FORMAT": "jpeg",
				"OG_IMAGE_QUALITY": "80",
				"EDGE_CACHE_TTL": "31536000",
				"BROWSER_CACHE_TTL": "15778476",
				"CATCH_ALL_EXTERNAL": "false",
				"SITE_ID": "69259def79719995b09e699d",
				"PURIFIED_CSS_ENABLED": "true",
				"MINIFIED_CSS_LINK": "https://storage.bxstudio.cloud/styles.pure.css",
				"PROGRESSIVE_SECTIONS_ENABLED": "true",
				"OPTIMISE_LANDING_PAGE_ONLY": "true",
				"DISPATCH_EVENT": "BOTH",
				"CF_ZONE_ID": "b546996735d873188683fc53ccb2df41",
				"CF_API_TOKEN": "iXtEAlzJHoN9941z0VL3BkVtbRaFz9l6NQGy5JgN"
			}
		}
	}
}
