{
	"name": "@bx/actian-worker",
	"version": "0.0.0",
	"private": true,
	"description": "Monorepo for Actian gated trial downloads (Webflow frontend + Cloudflare Worker).",
	"type": "module",
	"scripts": {
		"dev": "concurrently \"pnpm --filter @actian/frontend dev\" \"pnpm --filter @actian/server dev\"",
		"build": "concurrently \"pnpm --filter @actian/frontend build\" \"pnpm --filter @actian/server build\"",
		"dev:frontend": "pnpm --filter @actian/frontend dev",
		"build:frontend": "pnpm --filter @actian/frontend build",
		"deploy:frontend": "pnpm --filter @actian/frontend deploy",
		"dev:server": "pnpm --filter @actian/server dev",
		"build:server": "pnpm --filter @actian/server build",
		"deploy": "pnpm --filter @actian/server deploy",
		"deploy:server": "pnpm --filter @actian/server deploy:production",
		"lint": "pnpm -r lint",
		"lint:fix": "pnpm -r lint:fix",
		"check": "pnpm --filter @actian/frontend check && pnpm --filter @actian/server check",
		"test": "pnpm --filter @actian/server test -- --run",
		"cf-typegen": "pnpm --filter @actian/server cf-typegen",
		"wrangler:login": "wrangler login",
		"wrangler:logout": "wrangler logout"
	},
	"devDependencies": {
		"concurrently": "^9.1.2",
		"prettier": "^3.6.2",
		"typescript": "^5.5.2",
		"wrangler": "^4.47.0"
	},
	"engines": {
		"pnpm": ">=10"
	}
}
